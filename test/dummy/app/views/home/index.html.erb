<% dummy_page_nav(title: "Library Demo", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Library Demo",
    subtitle: "A workspace library of samples, plus a page that places them in order.",
    variant: :h1
  ) %>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Library",
          subtitle: "Samples live in the workspace library. Open list or grid.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>
      <% card.body do %>
        <% if @library %>
          <div class="flex flex-wrap gap-3">
            <%= render FlatPack::Button::Component.new(
              text: "Open library",
              style: :primary,
              size: :md,
              href: library_path_for(@library, view: :grid)
            ) %>
            <%= render FlatPack::Button::Component.new(
              text: "List view",
              style: :secondary,
              size: :md,
              href: library_path_for(@library, view: :list)
            ) %>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Homepage gallery",
          subtitle: "A showcase that places library samples (and a page from outside the library).",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>
      <% card.body do %>
        <% if @showcase_recording %>
          <div class="flex flex-wrap gap-3">
            <%= render FlatPack::Button::Component.new(
              text: "Edit placements",
              style: :primary,
              size: :md,
              href: library_placements_path_for(@showcase_recording)
            ) %>
            <%= render FlatPack::Button::Component.new(
              text: "Choose from library",
              style: :secondary,
              size: :md,
              href: library_picker_path_for(@showcase_recording)
            ) %>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Placed on the homepage",
          subtitle: "Resolved through the library gem, skipping anything in trash.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>
      <% card.body do %>
        <% if @resolved.present? %>
          <%= render FlatPack::List::Component.new(divider: true) do %>
            <% @resolved.each do |resolved| %>
              <%= render FlatPack::List::Item.new do %>
                <div class="flex items-center gap-3">
                  <div class="h-12 w-12 overflow-hidden rounded-lg">
                    <%= resolved.adapter.preview(self) %>
                  </div>
                  <div>
                    <p class="font-medium"><%= resolved.adapter.title %></p>
                    <p class="text-xs text-(--surface-muted-content-color)"><%= resolved.adapter.type_label %></p>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% end %>
        <% else %>
          <p class="text-sm leading-6">Nothing placed yet.</p>
        <% end %>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "How it works",
          subtitle: "Hosts mount a library. Items stay their own types. Placements only store order.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>
      <% card.body do %>
        <ul class="space-y-3 text-sm leading-6">
          <li>The workspace opens a keyed library on first use. People never title or create that library.</li>
          <li>Samples are ordinary child items of the library, rendered by a built-in test adapter.</li>
          <li>The homepage gallery holds ordered pointers. Those pointers can also aim at a page that is not in the library, as long as it is in the same workspace.</li>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>
